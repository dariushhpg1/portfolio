---
import { profile } from '../data/portfolio';
import { url } from '../utils/paths';
---
<header class="site-header" id="site-header">
  <div class="shell header-inner">
    <a class="brand" href="#top" aria-label="Darius H. — back to top">
      <img class="brand-avatar" src={url(profile.avatar)} alt="Darius H." width="44" height="44" />
      <span class="brand-name">Darius H.<small>Product designer</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation"><a href="#work">Work</a><a href="#approach">Approach</a><a href="#about">About</a><a href="#experience">Experience</a><a href="#writing">Writing</a></nav>
    <a class="header-contact" href="#contact">Get in touch</a>
    <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu"><span></span><span></span></button>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" hidden><a href="#work">Work</a><a href="#approach">Approach</a><a href="#about">About</a><a href="#experience">Experience</a><a href="#writing">Writing</a><a href="#contact">Contact</a></nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  if (toggle && menu) {
    const close = () => { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', 'Open menu'); };
    toggle.addEventListener('click', () => {
      const next = toggle.getAttribute('aria-expanded') !== 'true';
      menu.hidden = !next; toggle.setAttribute('aria-expanded', String(next));
      toggle.setAttribute('aria-label', next ? 'Close menu' : 'Open menu');
    });
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
    window.addEventListener('keydown', event => { if (event.key === 'Escape') close(); });
    window.addEventListener('resize', () => { if (window.innerWidth > 860) close(); });
  }
</script>
