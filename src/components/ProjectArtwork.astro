---
import { url } from '../utils/paths';
interface Props { kind: 'blu' | 'icons' | 'khooger'; imageSrc?: string }
const { kind, imageSrc } = Astro.props;
const imageUrl = imageSrc ? url(imageSrc) : undefined;
const iconPaths = [
  'M12 3 3 8v9l9 5 9-5V8z M3 8l9 5 9-5 M12 13v9',
  'M3 12h18 M12 3v18',
  'M4 7h16v11H4z M8 4h8 M9 21h6',
  'M5 17l4-4 3 3 7-8 M16 8h3v3',
  'M12 21s7-4 7-10a7 7 0 1 0-14 0c0 6 7 10 7 10z M12 11h.01',
  'M4 5h16v14H4z M4 9h16 M9 9v10',
  'M4 12c3-8 13-8 16 0-3 8-13 8-16 0z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
  'M8 4h8l4 6-8 11L4 10z M4 10h16 M8 4l4 6 4-6',
  'M12 2v20 M2 12h20 M5 5l14 14 M19 5 5 19',
  'M5 7h14 M5 12h14 M5 17h14',
  'M12 3 3 12l9 9 9-9z',
  'M4 4h16v16H4z M8 8h8v8H8z',
  'M6 4h12l2 7-8 10-8-10z',
  'M4 7h16v10H4z M8 11l3 3 5-5',
  'M7 3h10l4 9-9 9-9-9z M7 3l5 9 5-9',
  'M12 4c5 0 8 4 8 8s-3 8-8 8-8-4-8-8 3-8 8-8z M8 12h8',
];
---
<div class:list={['case-art', `case-art-${kind}`]} aria-label={`${kind} — abstract editorial artwork, not a product screenshot`} role="img">
  {kind === 'blu' && (
    <>
      {imageUrl && <img class="case-photo" src={imageUrl} alt="blu Bank design system cover" />}
      <div class="case-photo-overlay"></div>
      <div class="blu-logo-badge"><span class="blu-logo-mark">b</span><span>blu Bank</span></div>
      <div class="blu-feature-panel">
        <div class="coin-card-head"><span class="coin-wordmark">coin<span>✳</span></span><span>blubank.design</span></div>
        <div class="coin-card-title">A shared system<br/>for a growing<br/>banking ecosystem<span>.</span></div>
        <div class="coin-card-bottom"><span>TOKENS</span><span>COMPONENTS</span><span>DOCUMENTATION</span></div>
      </div>
      <div class="blu-float"><span>✦</span> Five years of focused system work</div>
      <div class="blu-art-bottom"><span>COIN / DESIGN SYSTEM</span><span>↗</span></div>
    </>
  )}
  {kind === 'icons' && (
    <>
      <span class="icons-bg-label">ICONA<br/>MOON.</span>
      <div class="icon-grid">
        {iconPaths.map((path, i) => (
          <div class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}/></svg></div>
        ))}
      </div>
      <div class="icons-footer"><span>2,400+ VECTOR ICONS</span><span>8 STYLES <b>↗</b></span></div>
    </>
  )}
  {kind === 'khooger' && (
    <>
      <div class="khooger-top"><span>KHOOGER / HOME & LIVING</span><span>EST. 2018</span></div>
      <div class="khooger-arch"><span class="khooger-sun"></span><div class="khooger-vase"></div><div class="khooger-stem"></div><div class="khooger-seat"><i></i></div><div class="khooger-rug"></div></div>
      <div class="khooger-type">Make room<br/><em>for living.</em></div>
      <div class="khooger-bottom"><span>FUNCTIONAL, WARM, HUMAN.</span><span>↗</span></div>
    </>
  )}
</div>
