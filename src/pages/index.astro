---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile, projects, capabilities, experience, articles, skillGroups } from '../data/portfolio';
import { url } from '../utils/paths';
const resumeLink = url(profile.resume);
---
<BaseLayout>
  <SiteHeader />
  <main id="main">
    <section class="hero shell" id="top" aria-labelledby="hero-title">
      <span class="eyebrow">{profile.eyebrow}</span>
      <h1 id="hero-title">{profile.headline}<br/><span>{profile.headlineAccent}</span></h1>
      <div class="hero-bottom">
        <p>{profile.introduction}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Selected work</a>
          <a class="button button-secondary" href="#about">About me</a>
        </div>
      </div>
    </section>

    <section class="section shell work-section" id="work" aria-labelledby="work-title">
      <div class="section-header"><span class="section-index">01 / Work</span><h2 id="work-title">Selected work<span class="period">.</span></h2></div>
      <div class="work-list">
        {projects.map((project) => (
          <article class:list={['work-card', {'work-card-featured': project.id === 'blu'}]} id={project.id}>
            <div class="work-media"><img src={url(project.coverImage)} alt={`${project.title} visual cover`} loading="lazy" decoding="async" /></div>
            <div class="work-content">
              <div class="work-meta"><span>{project.index} / {project.category}</span><span>{project.period}</span></div>
              {project.company === 'blu Bank' ? (
                <div class="company-pill"><span class="company-logo-wrap"><img src={url('images/blu-bank-logo.png')} alt="" /></span><span>blu Bank</span></div>
              ) : <span class="company-name">{project.company}</span>}
              <h3>{project.title}</h3>
              <p class="work-description">{project.description}</p>
              {project.stat && <div class="work-stat"><strong>{project.stat}</strong><span>{project.statLabel}</span></div>}
              <div class="work-actions">{project.links.map((link) => <a class:list={['button','work-button',link.kind === 'primary' ? 'button-primary' : 'button-secondary']} href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section approach-section" id="approach" aria-labelledby="approach-title">
      <div class="shell">
        <div class="section-header"><span class="section-index">02 / Approach</span><h2 id="approach-title">How I work<span class="period">.</span></h2></div>
        <div class="capabilities-grid">{capabilities.map((cap) => <div class="capability"><span class="capability-index">{cap.id}</span><h3>{cap.title}</h3><p>{cap.description}</p></div>)}</div>
      </div>
    </section>

    <section class="section shell about-section" id="about" aria-labelledby="about-title">
      <div class="section-header"><span class="section-index">03 / About</span><h2 id="about-title">A little about me<span class="period">.</span></h2></div>
      <div class="about-grid">
        <p class="about-lead">Good design brings structure to complexity.</p>
        <div class="about-content"><p>{profile.about}</p><a class="text-link" href={resumeLink} target="_blank" rel="noopener noreferrer">View résumé</a></div>
      </div>
      <div class="skill-groups">{skillGroups.map(group => <div class="skill-group"><strong>{group.label}</strong><p>{group.skills.join(' · ')}</p></div>)}</div>
    </section>

    <section class="section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="shell">
        <div class="section-header"><span class="section-index">04 / Experience</span><h2 id="experience-title">Experience<span class="period">.</span></h2></div>
        <div class="experience-list">{experience.map((item) => <div class="experience-row"><div><h3>{item.company}</h3><p>{item.role}</p></div><span>{item.period}</span></div>)}</div>
        <div class="education-row"><span>Education</span><p>Computer Engineering · Shahid Bahonar University of Kerman · 2015–2018</p></div>
      </div>
    </section>

    <section class="section shell writing-section" id="writing" aria-labelledby="writing-title">
      <div class="section-header"><span class="section-index">05 / Writing</span><h2 id="writing-title">Selected writing<span class="period">.</span></h2></div>
      <div class="article-grid">{articles.map((article) => <a class="article-card" href={article.href} target="_blank" rel="noopener noreferrer"><img src={url(article.image)} alt="" loading="lazy" decoding="async"/><div class="article-content"><span>{article.category}</span><h3>{article.title}</h3><span class="article-link">Read article</span></div></a>)}</div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="shell">
      <span class="section-index">06 / Contact</span>
      <h2 id="contact-title">Let’s make<br/>something meaningful.</h2>
      <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="contact-links"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={resumeLink} target="_blank" rel="noopener noreferrer">Résumé</a></div>
    </div></section>
  </main>
  <SiteFooter />
</BaseLayout>
